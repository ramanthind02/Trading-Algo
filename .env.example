# ──────────────────────────────────────────────────────────────────────────────
# Trading-Algo environment variables.
#
# Copy this file to `.env` (which IS gitignored) and fill in the real values.
# `scripts/_bootstrap.py` auto-loads `.env` at the repo root before any other
# import, so any script under `scripts/` will see these as `os.environ[...]`.
#
# Real env vars set in your shell ALWAYS take precedence over `.env` values
# (i.e. `.env` is a default, not an override).
# ──────────────────────────────────────────────────────────────────────────────

# ── CFD prop-firm Telegram channel ──────────────────────────────────────────
# Bot token from @BotFather (currently @quant_foundry_cfd_prop_firm_bot)
TELEGRAM_CFD_PROP_BOT_TOKEN=
# Numeric chat_id of the channel where approvals are posted. For channels
# this is usually a large NEGATIVE integer starting with -100... .
# Channel: "Quant Foundry - CFD Prop Firm Signals"
TELEGRAM_CFD_PROP_CHAT_ID=-1003982577750

# ── Futures prop-firm Telegram channel (existing) ───────────────────────────
TELEGRAM_PROP_BOT_TOKEN=
TELEGRAM_PROP_CHAT_ID=

# ── Personal Telegram channel (existing) ────────────────────────────────────
TELEGRAM_PERSONAL_BOT_TOKEN=
TELEGRAM_PERSONAL_CHAT_ID=

# ── MT5 accounts (CFD prop-firm) ────────────────────────────────────────────
# Add one block per account. The env-var NAMES referenced here must match the
# `username_env` / `password_env` / `server_env` fields in
# `configs/live_forecast_config_cfd_prop.json`.

# FTMO 100K demo account A
MT5_FTMO_100K_DEMO_A_USERNAME=
MT5_FTMO_100K_DEMO_A_PASSWORD=
MT5_FTMO_100K_DEMO_A_SERVER=FTMO-Demo
