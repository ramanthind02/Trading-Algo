#!/usr/bin/env sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/oc [--provider openai|zen] [--preset execute|research|dynamic] [--rag off|execute|research] [--] [opencode args...]

Wrapper around `opencode` that selects the right omos preset.

Defaults:
  --provider openai
  --preset execute

Examples:
  ./scripts/oc --provider openai --preset execute
  ./scripts/oc --provider zen --preset execute
  ./scripts/oc --provider zen --preset research
  ./scripts/oc --provider zen --preset execute -- --version
EOF
}

provider="openai"
preset="execute"
rag_mode=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --provider)
      [ "$#" -ge 2 ] || { echo "--provider requires a value" >&2; exit 2; }
      provider="$2"
      shift 2
      ;;
    --preset)
      [ "$#" -ge 2 ] || { echo "--preset requires a value" >&2; exit 2; }
      preset="$2"
      shift 2
      ;;
    --rag)
      [ "$#" -ge 2 ] || { echo "--rag requires a value" >&2; exit 2; }
      rag_mode="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

case "$provider" in
  openai|zen)
    ;;
  *)
    echo "Invalid --provider: $provider (expected openai|zen)" >&2
    exit 2
    ;;
esac

case "$preset" in
  execute|research|dynamic)
    ;;
  *)
    echo "Invalid --preset: $preset (expected execute|research|dynamic)" >&2
    exit 2
    ;;
esac

if [ -n "$rag_mode" ]; then
  case "$rag_mode" in
    off|execute|research)
      export RAG_MODE="$rag_mode"
      ;;
    *)
      echo "Invalid --rag: $rag_mode (expected off|execute|research)" >&2
      exit 2
      ;;
  esac
fi

if [ "$provider" = "zen" ]; then
  export OH_MY_OPENCODE_SLIM_PRESET="${preset}_zen"
else
  export OH_MY_OPENCODE_SLIM_PRESET="$preset"
fi

exec opencode "$@"
