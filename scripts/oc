#!/usr/bin/env sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/oc [--rag off|execute|research] [--] [opencode args...]

Minimal wrapper around `opencode`.

Defaults:
  RAG_MODE=off

Examples:
  ./scripts/oc
  ./scripts/oc --rag execute
  ./scripts/oc --rag research
  ./scripts/oc -- --version
EOF
}

rag_mode="off"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --rag)
      [ "$#" -ge 2 ] || { echo "--rag requires a value" >&2; exit 2; }
      rag_mode="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

case "$rag_mode" in
  off|execute|research)
    export RAG_MODE="$rag_mode"
    ;;
  *)
    echo "Invalid --rag: $rag_mode (expected off|execute|research)" >&2
    exit 2
    ;;
esac

exec opencode "$@"
